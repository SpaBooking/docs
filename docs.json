{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SpaPortal Docs",
  "colors": {
    "primary": "#0F766E",
    "light": "#14B8A6",
    "dark": "#0F766E"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Getting started",
        "icon": "rocket",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "api/v1/index"]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Guides",
            "pages": [
              "guides/index",
              "guides/authentication",
              "guides/pagination",
              "guides/localization",
              "guides/errors",
              "guides/booking",
              "guides/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "API v1",
            "root": "api/v1/index",
            "pages": [
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "/api/v1/openapi.yaml",
                  "directory": "api/v1/reference"
                }
              }
            ]
          },
          {
            "group": "API v2",
            "root": "api/v2/index",
            "pages": [
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "/api/v2/openapi.yaml",
                  "directory": "api/v2/reference"
                }
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "SpaPortal",
          "href": "https://spaportal.cz",
          "icon": "house"
        },
        {
          "anchor": "SpaBooking",
          "href": "https://spabooking.cz",
          "icon": "external-link"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:info@spaportal.cz"
      }
    ],
    "primary": {
      "type": "button",
      "label": "API v1",
      "href": "/api/v1"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {}
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.spaportal.cz"
    }
  }
}
