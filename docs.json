{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SpaPortal Docs",
  "colors": {
    "primary": "#3585BA",
    "light": "#99C246",
    "dark": "#141414"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Introduction",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "spaportal",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Guides",
            "pages": [
              "guides/index",
              "guides/booking",
              "guides/versioning"
            ]
          }
        ],
        "hidden": true
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "SpaPortal API",
            "pages": [
              "api/index",
              "api/authentication",
              "api/dates",
              "api/currencies",
              "api/localization",
              "api/pagination",
              "api/search",
              "api/sorting",
              "api/includes",
              "api/status-codes",
              "api/errors",
              "api/versioning"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "/api/v2/openapi.yaml",
              "directory": "api/v2/reference"
            }
          },
          {
            "group": "Previous Versions",
            "pages": [
              "api/v1",
              {
                "group": "API v1 endpoints",
                "openapi": {
                  "source": "/api/v1/openapi.yaml",
                  "directory": "api/v1/reference"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:info@spabooking.cz"
      }
    ],
    "primary": {
      "type": "button",
      "label": "SpaPortal",
      "href": "https://spaportal.cz/"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/untitled-page",
      "destination": "/api",
      "permanent": true
    },
    {
      "source": "/guides/authentication",
      "destination": "/api/authentication"
    },
    {
      "source": "/guides/pagination",
      "destination": "/api/pagination"
    },
    {
      "source": "/guides/localization",
      "destination": "/api/localization"
    },
    {
      "source": "/guides/errors",
      "destination": "/api/errors"
    },
    {
      "source": "/guides/webhooks",
      "destination": "/api"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/api"
    },
    {
      "source": "/api/conventions",
      "destination": "/api",
      "permanent": true
    }
  ],
  "footer": {
    "socials": {}
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.spaportal.cz"
    }
  }
}
